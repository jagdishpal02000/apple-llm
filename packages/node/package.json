{
  "name": "apple-llm",
  "version": "0.1.0",
  "description": "Apple's on-device (Foundation Models) and Private Cloud Compute LLMs from Node. No API key, no account, macOS 26+ on Apple Silicon.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagdishpal02000/apple-llm.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/jagdishpal02000/apple-llm#readme",
  "bugs": {
    "url": "https://github.com/jagdishpal02000/apple-llm/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "apple-llm": "dist/cli.js"
  },
  "files": [
    "dist",
    "swift",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "apple",
    "llm",
    "foundation-models",
    "on-device",
    "private-cloud-compute",
    "apple-intelligence",
    "macos",
    "local-llm",
    "structured-output"
  ],
  "scripts": {
    "build": "node ../../scripts/embed-helper.mjs && tsup",
    "test": "vitest run",
    "test:live": "APPLE_LLM_LIVE=1 vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
